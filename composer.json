{
    "name": "majesticdev/commandnet-s3-plugin",
    "description": "S3 (Operations) tooling for Zeus/GM support, mission development, and server administration.",
    "type": "forumify-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "forumify/forumify-platform": "^1.3",
        "majesticdev/commandnet-plugin": "^1.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "MajesticDev\\CommandNetS3\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "MajesticDev\\CommandNetS3\\CommandNetS3Plugin"
    }
}
